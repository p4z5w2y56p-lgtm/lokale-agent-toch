# Copy to .env (git-ignored) or set these in the environment's secrets settings.
# NEVER put a mainnet private key or seed phrase anywhere in this repo.

# Use ONE of these as the agent's brain (or neither, to run the rule-based baseline):
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Stage 0 = replay, 1 = live paper, 2 = testnet. Stages 3-4 are locked.
AGENT_STAGE=0

# Only needed from stage 2 (testnet). Use a brand-new throwaway wallet.
RPC_URL=
CHAIN_ID=84532
SIGNER_PRIVATE_KEY=
